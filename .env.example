# ─── Database (Vercel Postgres / Neon) ───────────────────────────────────────
#
# Easiest path:
#   vercel env pull .env.local
#
# That writes every POSTGRES_* variable Vercel has. The app and drizzle-kit both
# read POSTGRES_URL, so make sure that line ended up in .env.local — if Vercel
# only populated POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING, copy one of
# those values into POSTGRES_URL yourself.
#
# Pooled connection — used by the app at runtime.
POSTGRES_URL=

# Direct (non-pooled) connection. Not required today; keep it around if you
# later hit pgbouncer limitations with migrations.
# POSTGRES_URL_NON_POOLING=


# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
#
# From clerk.com > your application > API Keys.
# Use pk_test_/sk_test_ locally and pk_live_/sk_live_ in Vercel production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=


# ─── Escape hatch ────────────────────────────────────────────────────────────
#
# Skips the @t3-oss/env-nextjs startup validation in src/env.js. Useful for
# Docker builds or CI where the DB is not reachable.
# SKIP_ENV_VALIDATION=1
