# Database (Vercel Postgres)
# After connecting Vercel Postgres to your project, run: vercel env pull .env.local
# Then set POSTGRES_URL to the value of POSTGRES_URL from your pulled env vars.
POSTGRES_URL="postgresql://user:password@host:5432/dbname"

# Set to 1 to skip env validation during builds (e.g. while DB is not yet connected)
# SKIP_ENV_VALIDATION=1
# Recommended for most uses
POSTGRES_URL=

# For uses requiring a connection without pgbouncer
POSTGRES_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=
